.{
    .id = "dev.replicator.builder",
    .name = "replicator",
    .display_name = "Replicator",
    .description = "Build and revise personal native desktop Utilities.",
    .version = "0.1.0",
    .icons = .{ "assets/replicator-icon.png" },
    .assets = .{ .images = .{ .{ .id = 1, .path = "assets/replicator-icon.png" } } },
    .platforms = .{ "macos" },
    .permissions = .{ "view", "command" },
    .capabilities = .{ "native_views", "gpu_surfaces" },
    .theme = "geist",
    .theme_accent = "#69E6BA",
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "Replicator",
                .width = 1440,
                .height = 1024,
                .min_width = 880,
                .min_height = 680,
                .restore_state = true,
                .restore_policy = "center_on_primary",
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Builder canvas", .accessibility_label = "Replicator Utility builder", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .commands = .{
        .{ .id = "app.new-utility", .title = "New Utility" },
        .{ .id = "app.quit", .title = "Quit Replicator" },
    },
    .menus = .{
        .{ .title = "Replicator", .items = .{
            .{ .label = "New Utility", .command = "app.new-utility", .key = "n", .modifiers = .{ "primary" } },
            .{ .separator = true },
            .{ .label = "Quit Replicator", .command = "app.quit", .key = "q", .modifiers = .{ "primary" } },
        } },
    },
    .shortcuts = .{
        .{ .id = "app.new-utility", .key = "n", .modifiers = .{ "primary" } },
        .{ .id = "app.quit", .key = "q", .modifiers = .{ "primary" } },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
}
