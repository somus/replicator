.{
    .id = "dev.replicator.builder",
    .name = "replicator",
    .display_name = "Replicator",
    .description = "Build and revise personal native desktop Utilities.",
    .version = "0.1.0",
    .platforms = .{ "macos" },
    .permissions = .{ "view", "command" },
    .capabilities = .{ "native_views", "gpu_surfaces" },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "Replicator",
                .width = 1180,
                .height = 780,
                .min_width = 920,
                .min_height = 620,
                .restore_state = true,
                .restore_policy = "center_on_primary",
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Builder canvas", .accessibility_label = "Replicator Utility builder", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
}
