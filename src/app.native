<row background="background" label="Replicator builder">
  <column width="372" background="surface" label="Utility Library">
    <column padding="24" gap="22">
      <row gap="10" cross="center">
        <image image="{brandImageId}" width="42" height="42" label="Replicator logo" />
        <text size="heading"><span weight="bold">Replicator</span></text>
      </row>

      <row gap="8" cross="center">
        <text grow="1" foreground="text_muted"><span weight="bold">Utilities</span></text>
        <button size="sm" variant="secondary" icon="plus" disabled="{globalBusy}" on-press="new_utility">New Utility</button>
      </row>
    </column>

    <scroll grow="1" label="Your Utilities">
      <column padding="12" gap="8">
        <if test="{focusSelected}">
          <button variant="secondary" on-press="select_focus" label="Focus Sprint Utility">Focus Sprint - {selectedStatus}</button>
        </if>
        <else>
          <button variant="ghost" on-press="select_focus" label="Focus Sprint Utility">Focus Sprint - {selectedStatus}</button>
        </else>
        <column padding="4" gap="2">
          <text size="sm">Stay focused. Get more done.</text>
          <text size="sm" foreground="accent">{selectedStatus}</text>
        </column>
      </column>
    </scroll>

    <column padding="20" gap="8">
      <panel padding="12" background="background" radius="md" label="Owner">
        <row gap="10" cross="center">
          <badge variant="primary">S</badge>
          <column grow="1" gap="2">
            <text size="sm" foreground="text_muted">Owned by</text>
            <text><span weight="bold">Somu</span></text>
          </column>
        </row>
      </panel>
    </column>
  </column>

  <separator />

  <column grow="1" label="Selected Utility workspace">
    <row height="150" padding="28" gap="18" cross="center" background="surface" label="Utility Header">
      <panel width="72" height="72" padding="20" background="background" radius="lg">
        <text size="heading" foreground="accent"><span weight="bold">{selectedInitial}</span></text>
      </panel>
      <column grow="1" gap="7">
        <row gap="10" cross="center">
          <text size="heading"><span weight="bold">{selectedName}</span></text>
          <badge variant="secondary">{selectedStatus}</badge>
        </row>
        <text foreground="text_muted">{selectedDescription}</text>
      </column>
      <if test="{canLaunch}">
        <button variant="primary" icon="play" on-press="launch" label="Launch selected Utility">Launch</button>
      </if>
      <else>
        <button variant="primary" icon="play" disabled="true" label="No Ready Artifact to launch">Launch</button>
      </else>
      <button variant="ghost" icon="menu" label="More actions">More</button>
    </row>

    <separator />

    <scroll grow="1" label="Owner Timeline">
      <column padding="32" gap="14">
        <row gap="10" cross="center">
          <text size="heading" grow="1"><span weight="bold">Owner Timeline</span></text>
          <if test="{globalBusy}">
            <badge variant="secondary">One request active</badge>
          </if>
        </row>

        <if test="{focusSelected}">
          <if test="{hasPlan}"><panel padding="16" background="surface" radius="lg" label="Accepted plan"><column gap="8"><row gap="8"><badge variant="secondary">Plan</badge><text><span weight="bold">Accepted plan</span></text></row><text wrap="true">{acceptedPlan}</text><text size="sm" foreground="text_muted">Utility Format: bounded Native</text></column></panel></if>

          <if test="{hasEvidence}"><panel padding="16" background="surface" radius="lg" label="Verification Evidence"><column gap="8"><row gap="8"><badge variant="primary">Evidence</badge><text><span weight="bold">Verification Evidence</span></text></row><text wrap="true">{verificationEvidence}</text><text size="sm" foreground="text_muted">Bound to the verified source digest.</text></column></panel></if>

          <if test="{canLaunch}"><panel padding="16" background="surface" radius="lg" label="Ready outcome"><row gap="10" cross="center"><badge variant="primary">Ready</badge><text grow="1">Built, verified, and ready to launch.</text><button size="sm" variant="secondary" icon="play" on-press="launch" label="Launch Focus Sprint">Launch</button></row></panel></if>

          <if test="{revisionSubmitted}">
            <panel padding="16" background="surface" radius="lg" label="Request from You">
              <column gap="7">
                <row gap="8"><badge variant="primary">You</badge><text size="sm" foreground="text_muted">{submittedTitle}</text></row>
                <text wrap="true">{submittedRevision}</text>
                <if test="{firstReferenceAttached}"><row gap="8"><badge variant="secondary">Reference Image</badge><text size="sm">focus-sprint-dark.png</text></row></if>
              </column>
            </panel>
          </if>

          <if test="{hasClarification}"><panel padding="16" background="surface" radius="lg" label="Clarification required"><column gap="9"><row gap="8"><badge variant="secondary">Needs input</badge><text><span weight="bold">Clarification required</span></text></row><text wrap="true">{clarificationQuestion}</text><text size="sm" wrap="true" foreground="text_muted">This attempt is paused safely. Cancel and include the missing detail in a new request.</text><button size="sm" variant="ghost" on-press="cancel_attempt">Cancel request</button></column></panel></if>

          <if test="{globalBusy}"><panel padding="16" background="surface" radius="lg" label="Request Attempt progress"><column gap="9"><row gap="8"><badge variant="secondary">{selectedStatus}</badge><text><span weight="bold">Creating your Utility</span></text></row><if test="{hasStageResult}"><text wrap="true">{stageResult}</text></if><text size="sm" foreground="text_muted">Planning, building, verification, and preparation run in one Request Attempt.</text><button size="sm" variant="ghost" on-press="cancel_attempt">Cancel request</button></column></panel></if>

          <if test="{hasOwnerError}"><panel padding="16" background="surface" radius="lg" label="Request stopped"><column gap="9"><row gap="8"><badge variant="secondary">{selectedStatus}</badge><text><span weight="bold">Request stopped</span></text></row><text wrap="true">{ownerError}</text><if test="{canLaunch}"><text size="sm" foreground="text_muted">Your previous Ready Artifact remains launchable.</text></if><button size="sm" variant="secondary" disabled="{retryDisabled}" on-press="retry_attempt">Retry</button></column></panel></if>
        </if>
      </column>
    </scroll>

    <separator />

    <column height="146" padding="16" gap="9" background="surface" label="Request composer">
      <row gap="8" cross="center">
        <text grow="1"><span weight="bold">{requestTitle}</span></text>
        <button size="sm" variant="ghost" disabled="{requestControlsDisabled}" on-press="attach_reference" label="Attach Reference Image">Reference Image</button>
      </row>
      <row gap="8" cross="center">
        <if test="{firstReferenceAttached}">
          <row gap="4" cross="center">
            <badge variant="secondary">Reference Image - focus-sprint-dark.png</badge>
            <button size="sm" variant="ghost" disabled="{requestControlsDisabled}" on-press="remove_first_reference" label="Remove focus-sprint-dark.png">Remove</button>
          </row>
        </if>
        <if test="{secondReferenceAttached}">
          <row gap="4" cross="center">
            <badge variant="secondary">Reference Image - timer-controls.jpg</badge>
            <button size="sm" variant="ghost" disabled="{requestControlsDisabled}" on-press="remove_second_reference" label="Remove timer-controls.jpg">Remove</button>
          </row>
        </if>
      </row>
      <row gap="10" cross="center">
        <textarea grow="1" height="54" text="{revisionText}" placeholder="{composerPlaceholder}" disabled="{requestControlsDisabled}" on-input="revision_edit" label="Request" />
        <button variant="primary" icon="send" disabled="{requestControlsDisabled}" on-press="send_revision" label="Submit Request">Submit</button>
      </row>
    </column>
  </column>
</row>
