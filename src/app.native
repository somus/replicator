<split value="{sidebarSplit}" on-resize="sidebar_resized" gap="1" label="Replicator App builder">
  <column min-width="280" background="surface" label="App Library">
    <column padding="24" gap="22">
      <row gap="10" cross="center">
        <image image="{brandImageId}" width="42" height="42" label="Replicator logo" />
        <text size="heading"><span weight="bold">Replicator</span></text>
      </row>

      <row gap="8" cross="center">
        <text grow="1" foreground="text_muted"><span weight="bold">Apps</span></text>
        <button size="sm" variant="secondary" icon="plus" disabled="{globalBusy}" on-press="new_utility">New App</button>
      </row>
    </column>

    <scroll grow="1" label="Your Apps">
      <list virtualized padding="12" gap="8">
        <for each="libraryItems" key="utilityId" as="utility">
          <list-item selected="{utility.utilityId == selectedUtilityId}" on-press="select_library:{utility.slot}" label="{utility.displayName}">{utility.displayName} - {utility.state}
            <context-menu><menu-item on-press="select_library:{utility.slot}">Open</menu-item></context-menu>
          </list-item>
        </for>
        <else>
          <panel padding="16" background="background" radius="md" label="No Apps yet"><column gap="6"><text><span weight="bold">No Apps yet</span></text><text size="sm" foreground="text_muted" wrap="true">Describe one in the Build Request below.</text></column></panel>
        </else>
      </list>
    </scroll>

    <column padding="20" gap="8">
      <panel padding="12" background="background" radius="md" label="Owner">
        <row gap="10" cross="center">
          <badge variant="primary">S</badge>
          <column grow="1" gap="2">
            <text size="sm" foreground="text_muted">Owned by</text>
            <text><span weight="bold">Somu</span></text>
          </column>
        </row>
      </panel>
    </column>
  </column>

  <column min-width="600" label="Selected App workspace">
    <row height="150" padding="28" gap="18" cross="center" background="surface" label="App Header">
      <panel width="72" height="72" padding="20" background="background" radius="lg">
        <text size="heading" foreground="accent"><span weight="bold">{selectedInitial}</span></text>
      </panel>
      <column grow="1" gap="7">
        <row gap="10" cross="center">
          <text size="heading"><span weight="bold">{selectedName}</span></text>
          <badge variant="secondary">{selectedStatus}</badge>
        </row>
        <text foreground="text_muted">{selectedDescription}</text>
      </column>
      <if test="{canLaunch}">
        <button variant="primary" icon="play" on-press="launch" label="Launch selected App">Launch</button>
      </if>
      <else>
        <button variant="primary" icon="play" disabled="true" label="No Ready Artifact to launch">Launch</button>
      </else>
      <button variant="ghost" icon="menu" label="More actions">More</button>
    </row>

    <separator />

    <scroll grow="1" label="Owner Timeline">
      <column padding="32" gap="14">
        <row gap="10" cross="center">
          <text size="heading" grow="1"><span weight="bold">Owner Timeline</span></text>
          <if test="{globalBusy}">
            <badge variant="secondary">One request active</badge>
          </if>
        </row>

        <for each="timelineItems" key="entryId" as="entry">
          <if test="{entry.kind == 'Build Request'}">
            <panel padding="16" background="surface" radius="lg" label="Request from You">
              <column gap="7">
                <row gap="8"><badge variant="primary">You</badge><text size="sm" foreground="text_muted">{entry.kind}</text></row>
                <text wrap="true">{entry.text}</text>
                <text size="sm" foreground="text_muted">{entry.createdAt}</text>
              </column>
            </panel>
          </if>
          <if test="{entry.kind == 'Revision Request'}">
            <panel padding="16" background="surface" radius="lg" label="Request from You">
              <column gap="7">
                <row gap="8"><badge variant="primary">You</badge><text size="sm" foreground="text_muted">{entry.kind}</text></row>
                <text wrap="true">{entry.text}</text>
                <text size="sm" foreground="text_muted">{entry.createdAt}</text>
              </column>
            </panel>
          </if>
          <if test="{entry.kind == 'Accepted Plan'}">
            <panel padding="16" background="surface" radius="lg" label="Accepted plan">
              <column gap="8">
                <row gap="8"><badge variant="secondary">Plan</badge><text><span weight="bold">Accepted plan</span></text></row>
                <text wrap="true">{entry.text}</text>
                <text size="sm" foreground="text_muted">App Format: bounded Native</text>
              </column>
            </panel>
          </if>
          <if test="{entry.kind == 'Verification Evidence'}">
            <panel padding="16" background="surface" radius="lg" label="Verification Evidence">
              <column gap="8">
                <row gap="8"><badge variant="primary">Evidence</badge><text><span weight="bold">Verification Evidence</span></text></row>
                <text wrap="true">{entry.text}</text>
                <text size="sm" foreground="text_muted">Bound to the verified source digest.</text>
              </column>
            </panel>
          </if>
          <if test="{entry.kind == 'Ready'}">
            <panel padding="16" background="surface" radius="lg" label="Ready outcome">
              <row gap="10" cross="center"><badge variant="primary">Ready</badge><text grow="1">{entry.text}</text><button size="sm" variant="secondary" icon="play" on-press="launch" label="Launch selected App">Launch</button></row>
            </panel>
          </if>
          <if test="{entry.kind == 'Clarification'}">
            <timeline gap="4"><timeline-item title="{entry.kind}" description="{entry.text}" meta="{entry.createdAt}" /></timeline>
          </if>
        </for>
          <if test="{hasClarification}"><panel padding="16" background="surface" radius="lg" label="Clarification required"><column gap="9"><row gap="8"><badge variant="secondary">Needs input</badge><text><span weight="bold">Clarification required</span></text></row><if test="{hasClarificationQuestion0}"><column gap="4"><text wrap="true">{clarificationQuestion0}</text><if test="{clarificationFirstIsChoice}"><radio-group gap="4" label="First clarification options"><radio checked="{clarificationOptionASelected}" on-toggle="choose_clarification_a" label="{clarificationOptionA}" /><radio checked="{clarificationOptionBSelected}" on-toggle="choose_clarification_b" label="{clarificationOptionB}" /></radio-group></if><else><textarea height="48" text="{clarificationAnswer0}" on-input="clarification_answer_0" label="Answer to first clarification" placeholder="Enter a short answer" /></else></column></if><if test="{hasClarificationQuestion1}"><column gap="4"><text wrap="true">{clarificationQuestion1}</text><textarea height="48" text="{clarificationAnswer1}" on-input="clarification_answer_1" label="Answer to second clarification" placeholder="Enter a short answer" /></column></if><if test="{hasClarificationQuestion2}"><column gap="4"><text wrap="true">{clarificationQuestion2}</text><textarea height="48" text="{clarificationAnswer2}" on-input="clarification_answer_2" label="Answer to third clarification" placeholder="Enter a short answer" /></column></if><if test="{hasClarificationQuestion3}"><column gap="4"><text wrap="true">{clarificationQuestion3}</text><textarea height="48" text="{clarificationAnswer3}" on-input="clarification_answer_3" label="Answer to fourth clarification" placeholder="Enter a short answer" /></column></if><if test="{hasClarificationQuestion4}"><column gap="4"><text wrap="true">{clarificationQuestion4}</text><textarea height="48" text="{clarificationAnswer4}" on-input="clarification_answer_4" label="Answer to fifth clarification" placeholder="Enter a short answer" /></column></if><if test="{hasClarificationQuestion5}"><column gap="4"><text wrap="true">{clarificationQuestion5}</text><textarea height="48" text="{clarificationAnswer5}" on-input="clarification_answer_5" label="Answer to sixth clarification" placeholder="Enter a short answer" /></column></if><row gap="8"><button size="sm" variant="primary" disabled="{clarificationIncomplete}" on-press="continue_clarification">Continue</button><button size="sm" variant="ghost" on-press="cancel_attempt">Cancel request</button></row></column></panel></if>

          <if test="{globalBusy}"><panel padding="16" background="surface" radius="lg" label="Request Attempt progress"><column gap="9"><stepper active="{round(stageIndex)}" label="Request stages"><step>Plan</step><step>Build</step><step>Verify</step><step>Prepare</step></stepper><progress value="{stageProgress}" label="Request progress" /><row gap="8" cross="center"><spinner /><badge variant="secondary">{selectedStatus}</badge><text><span weight="bold">Creating your App</span></text></row><if test="{hasStageResult}"><text wrap="true">{stageResult}</text></if><button size="sm" variant="ghost" on-press="cancel_attempt">Cancel request</button></column></panel></if>

          <if test="{hasOwnerError}"><alert text="Request stopped" variant="destructive"><column padding="16" gap="9"><text wrap="true">{ownerError}</text><if test="{canLaunch}"><text size="sm" foreground="text_muted">Your previous Ready Artifact remains launchable.</text></if><button size="sm" variant="secondary" disabled="{retryDisabled}" on-press="retry_attempt">Retry</button></column></alert></if>
      </column>
    </scroll>

    <column height="220" padding="16" gap="9" background="surface" label="Request composer">
      <row gap="8" cross="center">
        <text grow="1"><span weight="bold">{requestTitle}</span></text>
        <button size="sm" variant="ghost" disabled="{requestControlsDisabled}" on-press="attach_reference" label="Attach Reference Image">Reference Image</button>
      </row>
      <row gap="8" cross="center">
        <if test="{firstReferenceAttached}">
          <row gap="4" cross="center">
            <badge variant="secondary">Reference Image attached</badge>
            <button size="sm" variant="ghost" disabled="{requestControlsDisabled}" on-press="remove_first_reference" label="Remove attached Reference Image">Remove</button>
          </row>
        </if>
        <if test="{secondReferenceAttached}">
          <row gap="4" cross="center">
            <badge variant="secondary">Second Reference Image attached</badge>
            <button size="sm" variant="ghost" disabled="{requestControlsDisabled}" on-press="remove_second_reference" label="Remove second Reference Image">Remove</button>
          </row>
        </if>
      </row>
      <input-group height="96" label="Request composer"><textarea text="{revisionText}" placeholder="{composerPlaceholder}" disabled="{requestControlsDisabled}" on-input="revision_edit" on-submit="send_revision" label="Request" /><input-group-actions gap="8"><button variant="primary" icon="send" disabled="{requestControlsDisabled}" on-press="send_revision" label="Submit Request">Submit</button></input-group-actions></input-group>
    </column>
  </column>
</split>
