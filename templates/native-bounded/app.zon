.{
    .id = "dev.replicator.generated-app",
    .name = "generated-app",
    .display_name = "Generated App",
    .description = "A Utility created by Replicator.",
    .version = "0.1.0",
    .platforms = .{ "macos" },
    .permissions = .{ "view", "command" },
    .capabilities = .{ "native_views", "gpu_surfaces" },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "Generated App",
                .width = 480,
                .height = 320,
                .min_width = 360,
                .min_height = 240,
                .restore_state = false,
                .restore_policy = "center_on_primary",
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Utility canvas", .accessibility_label = "Generated App", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
}
